extends ../layout

block content
    div(class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8")

        //- Breadcrumb
        nav(class="mb-6 text-sm")
            a(href="/subjects", class="text-blue-600 hover:text-blue-700") ← Danh sách môn học
            span(class="mx-2 text-gray-400") /
            span(class="text-gray-600")= subject.name

        //- Header môn học
        div(class="bg-white rounded-2xl border border-gray-200 overflow-hidden mb-8")
            div(class="h-2 bg-blue-600")

            div(class="p-6 sm:p-8")
                div(class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4")
                    div(class="flex items-start gap-4")
                        div(class="w-14 h-14 rounded-xl bg-blue-50 flex items-center justify-center flex-shrink-0")
                            i(data-lucide="book-open", class="w-7 h-7 text-blue-600")

                        div
                            h1(class="text-2xl sm:text-3xl font-bold text-gray-900")= subject.name

                            if subject.code
                                p(class="mt-1 text-sm font-medium text-blue-600")= subject.code

                            if subject.description
                                p(class="mt-3 text-gray-600")= subject.description

                    div(class="text-right flex-shrink-0")
                        div(class="text-sm text-gray-500")
                            i(data-lucide="layers", class="w-4 h-4 inline-block mr-1")
                            | #{lessons ? lessons.length : 0} bài học

        //- Danh sách bài học
        h2(class="text-xl font-semibold text-gray-900 mb-4") Danh sách bài học

        if !lessons || lessons.length === 0
            div(class="bg-white rounded-2xl border border-gray-200 p-10 text-center")
                div(class="w-16 h-16 mx-auto rounded-full bg-gray-50 flex items-center justify-center mb-4")
                    i(data-lucide="inbox", class="w-8 h-8 text-gray-400")

                h3(class="text-lg font-semibold text-gray-900") Chưa có bài học
                p(class="mt-2 text-gray-500") Môn học này hiện chưa có bài học nào được công khai.
        else
            div(class="grid grid-cols-1 md:grid-cols-2 gap-4")
                each lesson in lessons
                    a(
                        href=`/lessons/${lesson._id}`
                        class="group block bg-white rounded-xl border border-gray-200 hover:border-blue-300 hover:shadow-md transition-all p-5"
                    )
                        div(class="flex items-start justify-between gap-4")
                            div(class="flex items-start gap-3 flex-1 min-w-0")
                                div(class="w-10 h-10 rounded-lg bg-blue-50 flex items-center justify-center flex-shrink-0")
                                    i(data-lucide="file-text", class="w-5 h-5 text-blue-600")

                                div(class="flex-1 min-w-0")
                                    h3(class="font-semibold text-gray-900 group-hover:text-blue-600 transition-colors")
                                        = lesson.title

                                    if lesson.description
                                        p(class="mt-1 text-sm text-gray-500 line-clamp-2")
                                            = lesson.description

                                    div(class="mt-2 flex items-center gap-3 text-xs text-gray-400")
                                        if lesson.createdAt
                                            span
                                                i(data-lucide="calendar", class="w-3 h-3 inline-block mr-1")
                                                | #{new Date(lesson.createdAt).toLocaleDateString("vi-VN")}
                                        if lesson.updatedAt && lesson.updatedAt !== lesson.createdAt
                                            span
                                                i(data-lucide="clock", class="w-3 h-3 inline-block mr-1")
                                                | Cập nhật #{new Date(lesson.updatedAt).toLocaleDateString("vi-VN")}

                            i(
                                data-lucide="chevron-right"
                                class="w-5 h-5 text-gray-400 group-hover:text-blue-600 transition-colors flex-shrink-0"
                            )