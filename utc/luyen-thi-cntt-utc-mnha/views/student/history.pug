extends ../layout

block content
  .container
    h1 Lịch sử nộp bài
    .toolbar
      button#refresh-btn Làm mới

    if !submissions || submissions.length === 0
      p.empty Chưa có bài nộp nào.
    else
      table.history-table
        thead
          tr
            th Bài
            th Điểm
            th Số lỗi
            th Model
            th Thời gian
            th Trạng thái
            th
        tbody
          each s in submissions
            tr(data-id=s._id)
              td= s.lessonId
              td
                strong= s.score ?? "—"
                | /#{s.maxScore}
              td
                if s.errorCount > 0
                  span.badge.badge-error= `${s.errorCount} lỗi`
                else
                  span.badge.badge-ok Không có lỗi
              td= s.model
              td= new Date(s.submittedAt).toLocaleString("vi-VN")
              td
                case s.status
                  when "committed"
                    span.badge.badge-ok ✔ Đã lưu
                  when "pending"
                    span.badge.badge-warn ⏳ Đang đồng bộ
                  default
                    span.badge= s.status
              td
                a.btn(href=`/student/submissions/${s._id}`) Xem chi tiết
                if s.githubUrl
                  |  
                  a.btn.btn-gh(href=s.githubUrl target="_blank" rel="noopener") GitHub