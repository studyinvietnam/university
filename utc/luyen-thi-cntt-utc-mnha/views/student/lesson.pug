extends ../layout

block content
    .max-w-5xl.mx-auto.px-4.sm:px-6.lg:px-8.py-8
        // Breadcrumb
        .flex.items-center.gap-2.text-sm.text-gray-500.mb-6
            a.hover:text-blue-600.transition-colors(href="/student/subjects")
                | Môn học
            i(data-lucide="chevron-right").w-4.h-4
            if subject
                span #{subject.name}
                i(data-lucide="chevron-right").w-4.h-4
            span.text-gray-900.font-medium
                | #{lesson.name}

        // Lesson header
        .bg-white.rounded-2xl.border.border-gray-200.overflow-hidden.mb-6
            .bg-gradient-to-r.from-blue-600.to-indigo-600.p-6.md:p-8.text-white
                .flex.flex-col.md:flex-row.md:items-start.md:justify-between.gap-6
                    div
                        if lesson.code
                            span.inline-flex.items-center.px-3.py-1.rounded-full.bg-white.bg-opacity-20.text-sm.font-medium.mb-3
                                | #{lesson.code}

                        h1.text-2xl.md:text-3xl.font-bold
                            | #{lesson.name}

                        if lesson.description
                            p.mt-3.text-blue-100
                                | #{lesson.description}

                    if lesson.assignmentCount !== undefined
                        .bg-white.bg-opacity-10.rounded-xl.px-5.py-4.text-center
                            .text-2xl.font-bold #{lesson.assignmentCount}
                            .text-sm.text-blue-100 Bài tập

            .p-6.md:p-8
                if lesson.content
                    .prose.max-w-none.text-gray-700
                        != lesson.content

                // Assignment list
                if assignments && assignments.length
                    .mt-8
                        .flex.items-center.justify-between.mb-5
                            h2.text-xl.font-bold.text-gray-900 Danh sách bài tập
                            span.text-sm.text-gray-500 #{assignments.length} bài

                        .space-y-4
                            each assignment in assignments
                                .border.border-gray-200.rounded-xl.p-5.hover:border-blue-300.hover:shadow-sm.transition-all
                                    .flex.flex-col.md:flex-row.md:items-center.md:justify-between.gap-4
                                        div.flex-1
                                            .flex.items-start.gap-3
                                                .w-10.h-10.rounded-lg.bg-blue-50.flex.items-center.justify-center.flex-shrink-0
                                                    i(data-lucide="file-text").w-5.h-5.text-blue-600

                                                div
                                                    h3.font-semibold.text-gray-900
                                                        | #{assignment.title}

                                                    if assignment.description
                                                        p.mt-1.text-sm.text-gray-500
                                                            | #{assignment.description}

                                                    .mt-2.flex.flex-wrap.items-center.gap-3.text-xs.text-gray-500
                                                        if assignment.deadline
                                                            span
                                                                i(data-lucide="clock").w-3.5.h-3.5.inline-block.mr-1
                                                                | Hạn: #{assignment.deadline}

                                                        if assignment.maxScore
                                                            span
                                                                i(data-lucide="award").w-3.5.h-3.5.inline-block.mr-1
                                                                | #{assignment.maxScore} điểm

                                        a.inline-flex.items-center.justify-center.px-4.py-2.rounded-lg.bg-blue-600.text-white.text-sm.font-medium.hover:bg-blue-700.transition-colors(
                                            href=`/student/lessons/${lesson._id}/assignments/${assignment._id}`
                                        )
                                            | Làm bài
                                            i(data-lucide="arrow-right").w-4.h-4.ml-2

                else
                    .mt-8.bg-gray-50.rounded-xl.p-8.text-center
                        i(data-lucide="file-text").w-10.h-10.mx-auto.text-gray-400
                        h3.mt-3.font-semibold.text-gray-900 Chưa có bài tập
                        p.mt-1.text-sm.text-gray-500
                            | Bài học này hiện chưa có bài tập nào.