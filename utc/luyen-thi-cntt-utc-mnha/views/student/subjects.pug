extends ../layout

block content
    div(class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8")
        //- Header
        div(class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8")
            div
                h1(class="text-3xl font-bold text-gray-900") Danh sách môn học
                p(class="mt-1 text-gray-500") Chọn môn học để xem các bài tập và bài học.

            if subjects && subjects.length
                div(class="text-sm text-gray-500")
                    i(data-lucide="book-open", class="w-4 h-4 inline-block mr-1")
                    | #{typeof totalItems !== 'undefined' ? totalItems : subjects.length} môn học

        //- Tìm kiếm môn học
        form(action="/subjects", method="GET", class="mb-6 flex gap-3")
            div(class="relative flex-1")
                i(data-lucide="search", class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none")
                input(
                    type="search"
                    name="q"
                    value=(filters && filters.q) || ""
                    placeholder="Tìm môn học theo tên, mã môn hoặc mô tả..."
                    autocomplete="off"
                    class="w-full pl-9 pr-3 py-2.5 bg-white border border-gray-300 rounded-lg text-sm outline-none focus:ring-2 focus:ring-blue-500"
                )
            button(type="submit", class="px-4 py-2.5 bg-gray-900 text-white rounded-lg text-sm font-medium hover:bg-gray-800") Tìm
            if filters && filters.q
                a(href="/subjects", class="px-4 py-2.5 border border-gray-300 bg-white text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-50") Xoá lọc

        //- Empty state
        if !subjects || subjects.length === 0
            div(class="bg-white rounded-2xl border border-gray-200 p-10 text-center")
                div(class="w-16 h-16 mx-auto rounded-full bg-blue-50 flex items-center justify-center mb-4")
                    i(data-lucide="book-open", class="w-8 h-8 text-blue-600")

                if filters && filters.q
                    h2(class="text-xl font-semibold text-gray-900") Không tìm thấy môn học
                    p(class="mt-2 text-gray-500") Không có kết quả cho "#{filters.q}".
                else
                    h2(class="text-xl font-semibold text-gray-900") Chưa có môn học
                    p(class="mt-2 text-gray-500") Hiện tại chưa có môn học nào được công khai.

        //- Subject list
        else
            div(class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6")
                each subject in subjects
                    a(
                        href=`/subjects/${subject._id}`
                        class="group block bg-white rounded-2xl border border-gray-200 hover:border-blue-300 hover:shadow-lg transition-all duration-200 overflow-hidden"
                    )
                        div(class="h-2 bg-blue-600")

                        div(class="p-6")
                            div(class="flex items-start justify-between gap-4")
                                div(class="w-12 h-12 rounded-xl bg-blue-50 flex items-center justify-center flex-shrink-0")
                                    i(data-lucide="book-open", class="w-6 h-6 text-blue-600")

                                i(
                                    data-lucide="arrow-up-right"
                                    class="w-5 h-5 text-gray-400 group-hover:text-blue-600 transition-colors"
                                )

                            h2(class="mt-5 text-xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors")
                                | #{subject.name}

                            if subject.code
                                p(class="mt-1 text-sm font-medium text-blue-600")
                                    | #{subject.code}

                            if subject.description
                                p(class="mt-3 text-sm text-gray-500 line-clamp-3")
                                    | #{subject.description}

                            p(class="mt-3 text-xs text-gray-400")
                                i(data-lucide="user", class="w-3 h-3 inline-block mr-1")
                                | Người tạo môn: #{subject.createdBy && subject.createdBy.name ? subject.createdBy.name : 'Không rõ'}

                            div(class="mt-5 pt-4 border-t border-gray-100 flex items-center justify-between")
                                span(class="text-sm text-gray-500")
                                    i(data-lucide="layers", class="w-4 h-4 inline-block mr-1")
                                    | #{subject.lessonCount || 0} bài học

                                span(class="text-sm font-medium text-blue-600")
                                    | Xem môn học
                                    i(data-lucide="chevron-right", class="w-4 h-4 inline-block ml-1")

            //- Phân trang
            include ../pagination
