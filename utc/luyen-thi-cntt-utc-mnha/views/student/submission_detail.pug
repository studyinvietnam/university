extends ../layout

block content
  .container.submission-detail
    if readError
      .alert.alert-warn Không đọc được file GitHub: #{readError}. Đang dùng dữ liệu MongoDB.
    if !detail
      .alert.alert-error Không có dữ liệu chi tiết.
    else
      header.detail-header
        h1= detail.lessonTitle || detail.lessonSlug
        .score-box
          span.score-value= detail.score
          span.score-max /#{detail.maxScore}
        .meta
          span Model: #[code= detail.model]
          span Thời gian: #{new Date(detail.submittedAt).toLocaleString("vi-VN")}
          span Số từ: #{detail.wordCount}

      section
        h2 Đề bài
        p.topic= detail.topic || "(Không có đề bài)"

      section
        h2 Bài làm của bạn
        pre.essay= detail.essay

      section
        h2 Lỗi đã phát hiện (#{detail.feedback.grammar.errorCount})
        if detail.feedback.grammar.errors.length === 0
          p.ok ✅ Không phát hiện lỗi nào. Tuyệt vời!
        else
          each err, i in detail.feedback.grammar.errors
            .error-card
              .error-index ##{i + 1}
              .error-row
                span.label ❌ Gốc:
                code= err.original
              .error-row
                span.label ✅ Sửa:
                code= err.corrected
              .error-row
                span.label 💡 Giải thích:
                span= err.explanation

      section
        h2 Điểm chi tiết
        .score-grid
          .score-item
            .label Grammar
            .value= detail.feedback.grammar.score ?? "—"
            .comment= detail.feedback.grammar.comment
          .score-item
            .label Vocabulary
            .value= detail.feedback.vocabulary.score ?? "—"
            .comment= detail.feedback.vocabulary.comment
            if detail.feedback.vocabulary.suggestions.length
              ul.suggestions
                each sug in detail.feedback.vocabulary.suggestions
                  li= sug
          .score-item
            .label Coherence
            .value= detail.feedback.coherence.score ?? "—"
            .comment= detail.feedback.coherence.comment
          .score-item
            .label Content
            .value= detail.feedback.content.score ?? "—"
            .comment= detail.feedback.content.comment

      section
        h2 Outline
        .outline-grid
          .outline-item
            .label Mở bài — #{detail.feedback.outline.introduction.score ?? "—"}
            p= detail.feedback.outline.introduction.comment
          .outline-item
            .label Thân bài — #{detail.feedback.outline.body.score ?? "—"}
            p= detail.feedback.outline.body.comment
          .outline-item
            .label Kết bài — #{detail.feedback.outline.conclusion.score ?? "—"}
            p= detail.feedback.outline.conclusion.comment

      section
        h2 Nhận xét tổng quan
        p.overall= detail.feedback.overall

      .two-columns
        section
          h2 💪 Điểm mạnh
          ul
            each x in detail.feedback.strengths
              li= x
        section
          h2 ⚠️ Điểm yếu
          ul
            each x in detail.feedback.weaknesses
              li= x

      section
        h2 🎯 Cách cải thiện
        ol.improvements
          each x in detail.feedback.improvements
            li= x

      details.audit
        summary Prompt AI đã dùng (v#{detail.promptVersion || "?"})
        pre= detail.promptSnapshot

      if detail.sampleSolution
        details.audit
          summary Lời giải mẫu
          pre= detail.sampleSolution

      footer
        a.btn(href="/student/history") ← Lịch sử
        if githubUrl
          a.btn.btn-gh(href=githubUrl target="_blank" rel="noopener") Mở trên GitHub