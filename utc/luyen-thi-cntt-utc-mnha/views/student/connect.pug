extends ../layout

block content
    div(class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8")
        h1(class="text-2xl font-bold text-gray-900 mb-1") Kết nối tổ chức
        p(class="text-gray-500 mb-6 text-sm") Nhập mã do giảng viên/tổ chức cung cấp để làm thêm bài của tổ chức đó. Bạn có thể kết nối nhiều tổ chức.

        if error
            div(class="mb-4 p-3 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700")= error
        if success
            div(class="mb-4 p-3 rounded-lg bg-green-50 border border-green-200 text-sm text-green-700")= success

        form(method="POST" action="/student/connect" class="bg-white border border-gray-200 rounded-2xl p-5 shadow-sm mb-6 flex gap-3")
            input(type="text" name="code" required maxlength="32" placeholder="Mã tổ chức" class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm uppercase")
            button(type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700 transition") Kết nối

        div(class="bg-white border border-gray-200 rounded-2xl shadow-sm divide-y divide-gray-100")
            div(class="p-4 flex items-center justify-between")
                div
                    p(class="font-medium text-gray-900")= ownKey ? ownKey.name : 'Mặc định'
                    p(class="text-xs text-gray-500") Tổ chức gốc (do admin gán khi duyệt)
            each k in connected
                div(class="p-4 flex items-center justify-between")
                    div
                        p(class="font-medium text-gray-900")= k.name
                        p(class="text-xs text-gray-500")
                            span(class="font-mono")= k.code
                            if !k.active
                                |  · đang bị tắt
                    form(method="POST" action=`/student/connect/${k._id}/disconnect`)
                        button(type="submit" class="text-xs text-red-600 hover:underline") Ngắt kết nối
            if !connected.length
                div(class="p-4 text-sm text-gray-400") Chưa kết nối tổ chức nào khác.
