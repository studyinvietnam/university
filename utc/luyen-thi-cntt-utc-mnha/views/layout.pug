doctype html
html(lang="vi")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        meta(name="theme-color", content="#2563eb")

        title= title || 'Hệ thống luyện thi CNTT UTC'

        // Tailwind CSS
        script(src="https://cdn.tailwindcss.com")

        // Lucide Icons
        script(src="https://unpkg.com/lucide@latest")

        // CSS chính
        link(rel="stylesheet", href="/css/style.css")

    body.bg-gray-50.text-gray-900.min-h-screen
        // ================================
        // HEADER
        // ================================
        header.bg-white.border-b.border-gray-200.sticky.top-0.z-50
            .max-w-7xl.mx-auto.px-4.sm:px-6.lg:px-8
                .h-16.flex.items-center.justify-between

                    // Logo
                    a.flex.items-center.gap-3(href="/")
                        .w-10.h-10.rounded-xl.bg-blue-600.flex.items-center.justify-center
                            i(data-lucide="graduation-cap").w-6.h-6.text-white

                        .hidden.sm:block
                            .font-bold.text-gray-900 Luyện thi CNTT
                            .text-xs.text-gray-500 UTC

                    // Desktop navigation
                    nav.hidden.md:flex.items-center.gap-1
                        if user
                            if user.role === 'admin'
                                a.px-3.py-2.rounded-lg.text-sm.font-medium.text-gray-600.hover:text-blue-600.hover:bg-blue-50.transition-colors(
                                    href="/admin/dashboard"
                                )
                                    i(data-lucide="layout-dashboard").w-4.h-4.inline-block.mr-1
                                    | Dashboard

                                a.px-3.py-2.rounded-lg.text-sm.font-medium.text-gray-600.hover:text-blue-600.hover:bg-blue-50.transition-colors(
                                    href="/admin/subjects"
                                )
                                    i(data-lucide="book-open").w-4.h-4.inline-block.mr-1
                                    | Môn học

                                a.px-3.py-2.rounded-lg.text-sm.font-medium.text-gray-600.hover:text-blue-600.hover:bg-blue-50.transition-colors(
                                    href="/admin/lessons"
                                )
                                    i(data-lucide="layers").w-4.h-4.inline-block.mr-1
                                    | Bài học

                                a.px-3.py-2.rounded-lg.text-sm.font-medium.text-gray-600.hover:text-blue-600.hover:bg-blue-50.transition-colors(
                                    href="/admin/submissions"
                                )
                                    i(data-lucide="file-check-2").w-4.h-4.inline-block.mr-1
                                    | Bài nộp

                            else
                                a.px-3.py-2.rounded-lg.text-sm.font-medium.text-gray-600.hover:text-blue-600.hover:bg-blue-50.transition-colors(
                                    href="/student/subjects"
                                )
                                    i(data-lucide="book-open").w-4.h-4.inline-block.mr-1
                                    | Môn học

                                a.px-3.py-2.rounded-lg.text-sm.font-medium.text-gray-600.hover:text-blue-600.hover:bg-blue-50.transition-colors(
                                    href="/student/history"
                                )
                                    i(data-lucide="history").w-4.h-4.inline-block.mr-1
                                    | Lịch sử

                    // Right side
                    .flex.items-center.gap-2
                        if user
                            // Notification
                            a.relative.w-10.h-10.rounded-lg.flex.items-center.justify-center.text-gray-500.hover:bg-gray-100.hover:text-blue-600.transition-colors(
                                href="/notifications"
                                aria-label="Thông báo"
                            )
                                i(data-lucide="bell").w-5.h-5

                                if unreadCount && unreadCount > 0
                                    span.absolute.top-1.right-1.min-w-4.h-4.px-1.rounded-full.bg-red-500.text-white.text-[10px].font-bold.flex.items-center.justify-center
                                        | #{unreadCount > 99 ? '99+' : unreadCount}

                            // User menu
                            .relative
                                button#userMenuButton.flex.items-center.gap-2.px-2.py-1.5.rounded-lg.hover:bg-gray-100.transition-colors(
                                    type="button"
                                    aria-expanded="false"
                                )
                                    .w-9.h-9.rounded-full.bg-blue-100.flex.items-center.justify-center
                                        span.text-sm.font-bold.text-blue-700
                                            | #{(user.name || user.email || 'U').charAt(0).toUpperCase()}

                                    .hidden.lg:block.text-left
                                        p.text-sm.font-medium.text-gray-900.max-w-32.truncate
                                            | #{user.name || user.email}
                                        p.text-xs.text-gray-500
                                            | #{user.role === 'admin' ? 'Quản trị viên' : 'Sinh viên'}

                                    i(data-lucide="chevron-down").w-4.h-4.text-gray-400

                                #userDropdown.hidden.absolute.right-0.mt-2.w-52.bg-white.rounded-xl.border.border-gray-200.shadow-lg.overflow-hidden.z-50
                                    .px-4.py-3.border-b.border-gray-100
                                        p.text-sm.font-medium.text-gray-900.truncate
                                            | #{user.name || user.email}
                                        p.text-xs.text-gray-500.truncate
                                            | #{user.email}

                                    a.flex.items-center.gap-3.px-4.py-3.text-sm.text-gray-700.hover:bg-gray-50(
                                        href="/profile"
                                    )
                                        i(data-lucide="user").w-4.h-4
                                        | Hồ sơ

                                    a.flex.items-center.gap-3.px-4.py-3.text-sm.text-red-600.hover:bg-red-50(
                                        href="/auth/logout"
                                    )
                                        i(data-lucide="log-out").w-4.h-4
                                        | Đăng xuất

                        else
                            a.hidden.sm:inline-flex.items-center.px-4.py-2.rounded-lg.text-sm.font-medium.text-gray-700.hover:bg-gray-100(
                                href="/auth/login"
                            )
                                | Đăng nhập

                            a.inline-flex.items-center.px-4.py-2.rounded-lg.bg-blue-600.text-white.text-sm.font-medium.hover:bg-blue-700.transition-colors(
                                href="/auth/register"
                            )
                                | Đăng ký

                        // Mobile menu button
                        button#mobileMenuButton.md:hidden.w-10.h-10.rounded-lg.flex.items-center.justify-center.text-gray-600.hover:bg-gray-100(
                            type="button"
                            aria-label="Mở menu"
                        )
                            i(data-lucide="menu").w-5.h-5

            // Mobile navigation
            #mobileMenu.hidden.md:hidden.border-t.border-gray-200.bg-white
                .max-w-7xl.mx-auto.px-4.py-4.space-y-1
                    if user
                        if user.role === 'admin'
                            a.flex.items-center.gap-3.px-3.py-3.rounded-lg.text-sm.font-medium.text-gray-700.hover:bg-blue-50.hover:text-blue-600(
                                href="/admin/dashboard"
                            )
                                i(data-lucide="layout-dashboard").w-5.h-5
                                | Dashboard

                            a.flex.items-center.gap-3.px-3.py-3.rounded-lg.text-sm.font-medium.text-gray-700.hover:bg-blue-50.hover:text-blue-600(
                                href="/admin/subjects"
                            )
                                i(data-lucide="book-open").w-5.h-5
                                | Môn học

                            a.flex.items-center.gap-3.px-3.py-3.rounded-lg.text-sm.font-medium.text-gray-700.hover:bg-blue-50.hover:text-blue-600(
                                href="/admin/lessons"
                            )
                                i(data-lucide="layers").w-5.h-5
                                | Bài học

                            a.flex.items-center.gap-3.px-3.py-3.rounded-lg.text-sm.font-medium.text-gray-700.hover:bg-blue-50.hover:text-blue-600(
                                href="/admin/submissions"
                            )
                                i(data-lucide="file-check-2").w-5.h-5
                                | Bài nộp

                        else
                            a.flex.items-center.gap-3.px-3.py-3.rounded-lg.text-sm.font-medium.text-gray-700.hover:bg-blue-50.hover:text-blue-600(
                                href="/student/subjects"
                            )
                                i(data-lucide="book-open").w-5.h-5
                                | Môn học

                            a.flex.items-center.gap-3.px-3.py-3.rounded-lg.text-sm.font-medium.text-gray-700.hover:bg-blue-50.hover:text-blue-600(
                                href="/student/history"
                            )
                                i(data-lucide="history").w-5.h-5
                                | Lịch sử

                            a.flex.items-center.gap-3.px-3.py-3.rounded-lg.text-sm.font-medium.text-gray-700.hover:bg-blue-50.hover:text-blue-600(
                                href="/notifications"
                            )
                                i(data-lucide="bell").w-5.h-5
                                | Thông báo

                        a.flex.items-center.gap-3.px-3.py-3.rounded-lg.text-sm.font-medium.text-red-600.hover:bg-red-50(
                            href="/auth/logout"
                        )
                            i(data-lucide="log-out").w-5.h-5
                            | Đăng xuất
                    else
                        a.flex.items-center.gap-3.px-3.py-3.rounded-lg.text-sm.font-medium.text-gray-700.hover:bg-gray-50(
                            href="/auth/login"
                        )
                            i(data-lucide="log-in").w-5.h-5
                            | Đăng nhập

                        a.flex.items-center.gap-3.px-3.py-3.rounded-lg.text-sm.font-medium.text-blue-600.hover:bg-blue-50(
                            href="/auth/register"
                        )
                            i(data-lucide="user-plus").w-5.h-5
                            | Đăng ký

        // ================================
        // FLASH MESSAGE
        // ================================
        if success
            .max-w-7xl.mx-auto.px-4.sm:px-6.lg:px-8.pt-5
                .flash-message.flex.items-start.gap-3.p-4.rounded-xl.bg-green-50.border.border-green-200.text-green-800
                    i(data-lucide="check-circle-2").w-5.h-5.flex-shrink-0.mt-0.5
                    .flex-1.text-sm
                        | #{success}
                    button.flash-close.text-green-600.hover:text-green-800(
                        type="button"
                        aria-label="Đóng"
                    )
                        i(data-lucide="x").w-4.h-4

        if error
            .max-w-7xl.mx-auto.px-4.sm:px-6.lg:px-8.pt-5
                .flash-message.flex.items-start.gap-3.p-4.rounded-xl.bg-red-50.border.border-red-200.text-red-800
                    i(data-lucide="circle-alert").w-5.h-5.flex-shrink-0.mt-0.5
                    .flex-1.text-sm
                        | #{error}
                    button.flash-close.text-red-600.hover:text-red-800(
                        type="button"
                        aria-label="Đóng"
                    )
                        i(data-lucide="x").w-4.h-4

        // ================================
        // MAIN CONTENT
        // ================================
        main.min-h-[calc(100vh-145px)]
            block content

        // ================================
        // FOOTER
        // ================================
        footer.bg-white.border-t.border-gray-200.mt-12
            .max-w-7xl.mx-auto.px-4.sm:px-6.lg:px-8.py-8
                .flex.flex-col.md:flex-row.md:items-center.md:justify-between.gap-4
                    div
                        .flex.items-center.gap-2
                            .w-8.h-8.rounded-lg.bg-blue-600.flex.items-center.justify-center
                                i(data-lucide="graduation-cap").w-4.h-4.text-white
                            span.font-semibold.text-gray-900
                                | Luyện thi CNTT UTC

                        p.mt-2.text-sm.text-gray-500
                            | Hệ thống luyện tập và chấm bài tự động.

                    .flex.items-center.gap-4.text-sm.text-gray-500
                        span
                            | © #{new Date().getFullYear()} UTC

        // ================================
        // JAVASCRIPT
        // ================================
        script.
            document.addEventListener('DOMContentLoaded', function () {
                // Lucide icons
                if (window.lucide) {
                    lucide.createIcons();
                }

                // User dropdown
                const userMenuButton = document.getElementById('userMenuButton');
                const userDropdown = document.getElementById('userDropdown');

                if (userMenuButton && userDropdown) {
                    userMenuButton.addEventListener('click', function (event) {
                        event.stopPropagation();

                        const isHidden = userDropdown.classList.contains('hidden');

                        userDropdown.classList.toggle('hidden');

                        userMenuButton.setAttribute(
                            'aria-expanded',
                            String(isHidden)
                        );
                    });

                    document.addEventListener('click', function (event) {
                        if (
                            !userDropdown.contains(event.target) &&
                            !userMenuButton.contains(event.target)
                        ) {
                            userDropdown.classList.add('hidden');
                            userMenuButton.setAttribute('aria-expanded', 'false');
                        }
                    });
                }

                // Mobile menu
                const mobileMenuButton = document.getElementById('mobileMenuButton');
                const mobileMenu = document.getElementById('mobileMenu');

                if (mobileMenuButton && mobileMenu) {
                    mobileMenuButton.addEventListener('click', function () {
                        mobileMenu.classList.toggle('hidden');

                        const icon = mobileMenuButton.querySelector('svg');

                        if (icon) {
                            const isOpen = !mobileMenu.classList.contains('hidden');

                            icon.setAttribute(
                                'data-lucide',
                                isOpen ? 'x' : 'menu'
                            );

                            if (window.lucide) {
                                lucide.createIcons();
                            }
                        }
                    });
                }

                // Close flash messages
                document.querySelectorAll('.flash-close').forEach(function (button) {
                    button.addEventListener('click', function () {
                        const message = button.closest('.flash-message');

                        if (message) {
                            message.remove();
                        }
                    });
                });

                // Automatically hide flash messages
                setTimeout(function () {
                    document.querySelectorAll('.flash-message').forEach(function (message) {
                        message.style.transition = 'opacity 0.3s ease';
                        message.style.opacity = '0';

                        setTimeout(function () {
                            message.remove();
                        }, 300);
                    });
                }, 5000);
            });