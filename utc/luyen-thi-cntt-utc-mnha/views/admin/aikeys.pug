extends ../layout

block content
    .max-w-7xl.mx-auto.px-4.sm\\:px-6.lg\\:px-8.py-8

        .flex.flex-col.sm\\:flex-row.sm\\:items-center.sm\\:justify-between.gap-4.mb-8
            div
                h1(class="text-2xl sm:text-3xl font-bold text-gray-900")
                    | API Key AI
                p(class="text-gray-500 mt-1")
                    | Quản lý khóa API dùng cho hệ thống chấm bài

            button(
                type="button"
                onclick="document.getElementById('keyModal').classList.remove('hidden')"
                class="inline-flex items-center gap-2 px-4 py-2.5 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700"
            )
                i(data-lucide="plus" class="w-4 h-4")
                | Thêm API Key

        .bg-blue-50.border.border-blue-200.rounded-xl.p-4.mb-6
            .flex.items-start.gap-3
                i(data-lucide="shield-check" class="w-5 h-5 text-blue-600 mt-0.5")
                div
                    p(class="font-medium text-blue-900")
                        | Bảo mật API Key
                    p(class="text-sm text-blue-700 mt-1")
                        | API Key được lưu ở dạng mã hóa và không hiển thị đầy đủ trong giao diện.

        .grid.grid-cols-1.lg\\:grid-cols-2.gap-5
            if aiKeys && aiKeys.length
                each key in aiKeys
                    .bg-white.border.border-gray-200.rounded-2xl.p-5.shadow-sm
                        .flex.items-start.justify-between
                            div
                                .flex.items-center.gap-3
                                    .w-10.h-10.rounded-lg.bg-purple-100.text-purple-600.flex.items-center.justify-center
                                        i(data-lucide="key-round" class="w-5 h-5")
                                    div
                                        h2(class="font-semibold text-gray-900")
                                            = key.name || 'Gemini API Key'
                                        p(class="text-xs text-gray-500")
                                            = key.provider || 'Google Gemini'

                            if key.active
                                span(class="px-2.5 py-1 rounded-full bg-green-100 text-green-700 text-xs font-medium")
                                    | Đang hoạt động
                            else
                                span(class="px-2.5 py-1 rounded-full bg-gray-100 text-gray-600 text-xs font-medium")
                                    | Đã tắt

                        .mt-5.p-3.bg-gray-50.rounded-lg.font-mono.text-sm.text-gray-600
                            = key.maskedKey || '••••••••••••••••'

                        .mt-4.flex.items-center.justify-between
                            p(class="text-xs text-gray-500")
                                | Cập nhật:
                                = ' ' + (key.updatedAt ? new Date(key.updatedAt).toLocaleString('vi-VN') : '—')

                            .flex.items-center.gap-2
                                form(
                                    action="/admin/ai-keys/" + key._id + "/toggle"
                                    method="POST"
                                )
                                    button(
                                        type="submit"
                                        class="px-3 py-1.5 rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200 text-xs font-medium"
                                    )
                                        = key.active ? 'Tắt' : 'Bật'

                                form(
                                    action="/admin/ai-keys/" + key._id + "/delete"
                                    method="POST"
                                    onsubmit="return confirm('Bạn có chắc muốn xóa API Key này?')"
                                )
                                    button(
                                        type="submit"
                                        class="w-8 h-8 rounded-lg text-red-500 hover:bg-red-50 flex items-center justify-center"
                                    )
                                        i(data-lucide="trash-2" class="w-4 h-4")
            else
                .lg\\:col-span-2.bg-white.border.border-gray-200.rounded-2xl.py-12.text-center
                    i(data-lucide="key-round" class="w-10 h-10 mx-auto text-gray-300")
                    p(class="text-gray-500 mt-3")
                        | Chưa có API Key.

        #keyModal(class="hidden fixed inset-0 z-[100] bg-black/50 p-4")
            .min-h-full.flex.items-center.justify-center
                .bg-white.rounded-2xl.w-full.max-w-lg.shadow-xl
                    .px-6.py-5.border-b.border-gray-200.flex.items-center.justify-between
                        h2(class="font-bold text-gray-900")
                            | Thêm API Key
                        button(
                            type="button"
                            onclick="document.getElementById('keyModal').classList.add('hidden')"
                        )
                            i(data-lucide="x" class="w-5 h-5")

                    form(
                        action="/admin/ai-keys"
                        method="POST"
                        class="p-6 space-y-5"
                    )
                        div
                            label(class="block text-sm font-medium text-gray-700 mb-2")
                                | Tên
                            input(
                                type="text"
                                name="name"
                                required
                                placeholder="Gemini Key 01"
                                class="w-full px-3 py-2.5 border border-gray-300 rounded-lg"
                            )

                        div
                            label(class="block text-sm font-medium text-gray-700 mb-2")
                                | API Key
                            input(
                                type="password"
                                name="apiKey"
                                required
                                autocomplete="off"
                                class="w-full px-3 py-2.5 border border-gray-300 rounded-lg font-mono"
                                placeholder="AIza..."
                            )

                        button(
                            type="submit"
                            class="w-full py-2.5 bg-indigo-600 text-white rounded-lg font-medium hover:bg-indigo-700"
                        )
                            | Lưu API Key