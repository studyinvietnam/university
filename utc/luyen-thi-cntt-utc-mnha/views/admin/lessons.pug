extends ../layout

block content
    div(class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8")

        //- ============================================================
        //- HEADER
        //- ============================================================
        div(class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8")
            div
                h1(class="text-2xl sm:text-3xl font-bold text-gray-900")
                    | Quản lý bài học
                p(class="text-gray-500 mt-1")
                    | Quản lý bài học và bài tập của từng môn

            div(class="flex items-center gap-2")
                if !showDeleted
                    a(
                        href="/admin/lessons?deleted=1"
                        class="inline-flex items-center gap-2 px-4 py-2.5 border border-gray-300 text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-50 transition"
                    )
                        i(data-lucide="trash-2", class="w-4 h-4")
                        | Thùng rác
                else
                    a(
                        href="/admin/lessons"
                        class="inline-flex items-center gap-2 px-4 py-2.5 border border-gray-300 text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-50 transition"
                    )
                        i(data-lucide="arrow-left", class="w-4 h-4")
                        | Danh sách

                if !showDeleted
                    a(
                        href="/admin/lessons/create"
                        class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700 transition"
                    )
                        i(data-lucide="plus", class="w-4 h-4")
                        | Thêm bài học

        //- ============================================================
        //- FLASH
        //- ============================================================
        if success
            div(class="mb-6 p-4 rounded-xl bg-green-50 border border-green-200 text-green-800 text-sm")
                = success

        if error
            div(class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm")
                = error

        //- ============================================================
        //- FILTER
        //- ============================================================
        div(class="bg-white border border-gray-200 rounded-xl p-4 mb-6")
            form(
                action="/admin/lessons"
                method="GET"
                class="flex flex-col sm:flex-row gap-3"
            )
                if showDeleted
                    input(type="hidden", name="deleted", value="1")

                select(
                    name="subject"
                    class="px-3 py-2.5 border border-gray-300 rounded-lg text-sm outline-none focus:ring-2 focus:ring-indigo-500"
                )
                    option(value="") Tất cả môn học
                    if subjects
                        each subject in subjects
                            option(
                                value=subject._id
                                selected=(filters && filters.subject === String(subject._id))
                            )
                                = subject.name

                input(
                    type="text"
                    name="search"
                    value=(filters && filters.search) || ''
                    placeholder="Tìm bài học..."
                    class="flex-1 px-3 py-2.5 border border-gray-300 rounded-lg text-sm outline-none focus:ring-2 focus:ring-indigo-500"
                )

                button(
                    type="submit"
                    class="px-4 py-2.5 bg-gray-900 text-white rounded-lg text-sm font-medium hover:bg-gray-800"
                )
                    | Tìm kiếm

                a(
                    href=showDeleted ? "/admin/lessons?deleted=1" : "/admin/lessons"
                    class="px-4 py-2.5 border border-gray-300 text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-50"
                )
                    | Xoá lọc

        //- ============================================================
        //- LIST
        //- ============================================================
        if lessons && lessons.length
            div(class="space-y-3")
                each lesson, index in lessons
                    div(class="bg-white border border-gray-200 rounded-xl p-5 shadow-sm hover:shadow-md transition")

                        div(class="flex flex-col lg:flex-row lg:items-start justify-between gap-4")

                            //- LEFT: INFO
                            div(class="flex items-start gap-4 flex-1 min-w-0")

                                div(class="w-10 h-10 rounded-lg bg-indigo-100 text-indigo-600 flex items-center justify-center flex-shrink-0 font-semibold")
                                    = index + 1

                                div(class="flex-1 min-w-0")
                                    h2(class="font-semibold text-gray-900 break-words")
                                        = lesson.title

                                    div(class="flex items-center gap-2 mt-1 flex-wrap text-xs")
                                        if lesson.subject
                                            span(class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-blue-100 text-blue-700 font-medium")
                                                i(data-lucide="book-open", class="w-3 h-3")
                                                = lesson.subject.name

                                        span(class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-amber-100 text-amber-700 font-medium")
                                            i(data-lucide="clock", class="w-3 h-3")
                                            = (lesson.duration || 20) + ' phút'

                                        if lesson.isPublished
                                            span(class="px-2 py-0.5 rounded-full bg-green-100 text-green-700 font-medium")
                                                | Đã xuất bản
                                        else
                                            span(class="px-2 py-0.5 rounded-full bg-yellow-100 text-yellow-700 font-medium")
                                                | Bản nháp

                                    //- AI CONFIG
                                    div(class="flex items-center gap-2 mt-2 flex-wrap text-xs")
                                        if lesson.aiKeyId || lesson.model
                                            span(class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700 font-medium")
                                                i(data-lucide="bot", class="w-3 h-3")
                                                = lesson.model || 'Chưa chọn model'
                                        else
                                            span(class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-gray-100 text-gray-500 font-medium")
                                                i(data-lucide="bot", class="w-3 h-3")
                                                | Chưa cấu hình AI

                                    if lesson.description
                                        p(class="text-sm text-gray-600 mt-2 line-clamp-2")
                                            = lesson.description

                                    //- AUDIT
                                    div(class="text-xs text-gray-400 mt-2 space-y-0.5")
                                        if lesson.createdBy
                                            div
                                                | Tạo bởi: #{lesson.createdBy.name || lesson.createdBy.email}
                                        if lesson.createdAt
                                            div
                                                | #{new Date(lesson.createdAt).toLocaleString('vi-VN')}
                                        if lesson.updatedAt && lesson.updatedAt !== lesson.createdAt
                                            div
                                                | Cập nhật: #{new Date(lesson.updatedAt).toLocaleString('vi-VN')}

                            //- RIGHT: ACTIONS
                            div(class="flex items-center gap-2 flex-shrink-0 self-start")

                                if !showDeleted
                                    //- Xem trước
                                    a(
                                        href=`/lessons/${lesson._id}`
                                        class="w-9 h-9 rounded-lg flex items-center justify-center text-gray-500 hover:bg-gray-100 hover:text-green-600 transition"
                                        title="Làm thử"
                                    )
                                        i(data-lucide="play", class="w-4 h-4")

                                    //- Sửa
                                    a(
                                        href=`/admin/lessons/${lesson._id}/edit`
                                        class="w-9 h-9 rounded-lg flex items-center justify-center text-gray-500 hover:bg-gray-100 hover:text-indigo-600 transition"
                                        title="Chỉnh sửa"
                                    )
                                        i(data-lucide="pencil", class="w-4 h-4")

                                    //- Xoá tạm
                                    form(
                                        action=`/admin/lessons/${lesson._id}/delete`
                                        method="POST"
                                        onsubmit="return confirm('Bạn có chắc muốn xoá bài học này? Có thể khôi phục sau.')"
                                    )
                                        button(
                                            type="submit"
                                            class="w-9 h-9 rounded-lg flex items-center justify-center text-gray-500 hover:bg-red-50 hover:text-red-600 transition"
                                            title="Xoá"
                                        )
                                            i(data-lucide="trash-2", class="w-4 h-4")
                                else
                                    //- Khôi phục
                                    form(
                                        action=`/admin/lessons/${lesson._id}/restore`
                                        method="POST"
                                    )
                                        button(
                                            type="submit"
                                            class="inline-flex items-center gap-1 px-3 py-1.5 bg-green-50 text-green-700 rounded-lg text-xs font-medium hover:bg-green-100 transition"
                                        )
                                            i(data-lucide="rotate-ccw", class="w-3.5 h-3.5")
                                            | Khôi phục

                                    //- Xoá vĩnh viễn
                                    form(
                                        action=`/admin/lessons/${lesson._id}/hard-delete`
                                        method="POST"
                                        onsubmit="return confirm('XOÁ VĨNH VIỄN không thể hoàn tác. Chắc chắn?')"
                                    )
                                        button(
                                            type="submit"
                                            class="inline-flex items-center gap-1 px-3 py-1.5 bg-red-50 text-red-700 rounded-lg text-xs font-medium hover:bg-red-100 transition"
                                        )
                                            i(data-lucide="trash", class="w-3.5 h-3.5")
                                            | Xoá vĩnh viễn

        //- ============================================================
        //- EMPTY
        //- ============================================================
        else
            div(class="bg-white border border-gray-200 rounded-2xl py-16 text-center")
                div(class="w-14 h-14 rounded-full bg-gray-100 text-gray-400 flex items-center justify-center mx-auto")
                    i(data-lucide="layers", class="w-6 h-6")

                h2(class="font-semibold text-gray-900 mt-4")
                    if showDeleted
                        | Thùng rác trống
                    else
                        | Chưa có bài học

                p(class="text-sm text-gray-500 mt-1")
                    if showDeleted
                        | Không có bài học nào đã xoá.
                    else
                        | Hãy tạo bài học đầu tiên để bắt đầu.

                if !showDeleted
                    a(
                        href="/admin/lessons/create"
                        class="inline-flex items-center gap-2 mt-5 px-4 py-2.5 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700 transition"
                    )
                        i(data-lucide="plus", class="w-4 h-4")
                        | Thêm bài học