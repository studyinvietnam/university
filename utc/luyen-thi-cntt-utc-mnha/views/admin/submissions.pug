extends ../layout

block content
    .max-w-7xl.mx-auto.px-4.sm\\:px-6.lg\\:px-8.py-8

        .mb-8
            h1(class="text-2xl sm:text-3xl font-bold text-gray-900")
                | Quản lý bài nộp
            p(class="text-gray-500 mt-1")
                | Theo dõi và xử lý các bài nộp của sinh viên

        .bg-white.border.border-gray-200.rounded-xl.p-4.mb-6
            form(
                action="/admin/submissions"
                method="GET"
                class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3"
            )
                input(
                    type="text"
                    name="search"
                    value=filters?.search || ''
                    placeholder="Tên hoặc email sinh viên..."
                    class="px-3 py-2.5 border border-gray-300 rounded-lg text-sm"
                )

                select(
                    name="status"
                    class="px-3 py-2.5 border border-gray-300 rounded-lg text-sm"
                )
                    option(value="") Tất cả trạng thái
                    option(value="pending" selected=filters?.status === 'pending') Chờ chấm
                    option(value="grading" selected=filters?.status === 'grading') Đang chấm
                    option(value="graded" selected=filters?.status === 'graded') Đã chấm
                    option(value="failed" selected=filters?.status === 'failed') Lỗi

                select(
                    name="subject"
                    class="px-3 py-2.5 border border-gray-300 rounded-lg text-sm"
                )
                    option(value="") Tất cả môn học
                    if subjects
                        each subject in subjects
                            option(
                                value=subject._id
                                selected=filters?.subject == subject._id
                            )
                                = subject.name

                button(
                    type="submit"
                    class="px-4 py-2.5 bg-gray-900 text-white rounded-lg text-sm font-medium"
                )
                    | Lọc

        .bg-white.border.border-gray-200.rounded-2xl.shadow-sm.overflow-hidden
            if submissions && submissions.length
                .overflow-x-auto
                    table(class="w-full text-sm")
                        thead(class="bg-gray-50")
                            tr
                                th(class="px-5 py-3 text-left font-semibold text-gray-600")
                                    | Sinh viên
                                th(class="px-5 py-3 text-left font-semibold text-gray-600")
                                    | Bài học
                                th(class="px-5 py-3 text-left font-semibold text-gray-600")
                                    | Điểm
                                th(class="px-5 py-3 text-left font-semibold text-gray-600")
                                    | Trạng thái
                                th(class="px-5 py-3 text-left font-semibold text-gray-600")
                                    | Thời gian
                                th(class="px-5 py-3 text-right font-semibold text-gray-600")
                                    | 

                        tbody(class="divide-y divide-gray-100")
                            each submission in submissions
                                tr(class="hover:bg-gray-50")
                                    td(class="px-5 py-4")
                                        p(class="font-medium text-gray-900")
                                            = submission.student?.name || 'Chưa có tên'
                                        p(class="text-xs text-gray-500")
                                            = submission.student?.email || ''

                                    td(class="px-5 py-4")
                                        p(class="text-gray-800")
                                            = submission.lesson?.title || '—'
                                        p(class="text-xs text-gray-500")
                                            = submission.lesson?.subject?.name || ''

                                    td(class="px-5 py-4")
                                        if submission.score !== undefined && submission.score !== null
                                            span(class="font-bold text-gray-900")
                                                = submission.score
                                        else
                                            | —

                                    td(class="px-5 py-4")
                                        if submission.status === 'graded'
                                            span(class="px-2.5 py-1 rounded-full bg-green-100 text-green-700 text-xs font-medium")
                                                | Đã chấm
                                        else if submission.status === 'grading'
                                            span(class="px-2.5 py-1 rounded-full bg-blue-100 text-blue-700 text-xs font-medium")
                                                | Đang chấm
                                        else if submission.status === 'failed'
                                            span(class="px-2.5 py-1 rounded-full bg-red-100 text-red-700 text-xs font-medium")
                                                | Lỗi
                                        else
                                            span(class="px-2.5 py-1 rounded-full bg-yellow-100 text-yellow-700 text-xs font-medium")
                                                | Chờ chấm

                                    td(class="px-5 py-4 text-gray-500")
                                        = submission.createdAt ? new Date(submission.createdAt).toLocaleString('vi-VN') : '—'

                                    td(class="px-5 py-4")
                                        a(
                                            href="/admin/submissions/" + submission._id
                                            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200 text-xs font-medium"
                                        )
                                            i(data-lucide="eye" class="w-3.5 h-3.5")
                                            | Xem
            else
                .py-16.text-center
                    i(data-lucide="file-x" class="w-10 h-10 mx-auto text-gray-300")
                    p(class="text-gray-500 mt-3")
                        | Không có bài nộp phù hợp.