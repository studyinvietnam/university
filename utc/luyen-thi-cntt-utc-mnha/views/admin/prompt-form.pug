extends ../layout

block content
    div(class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8")

        //- Back
        div(class="mb-6")
            a(
                href="/admin/prompts"
                class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700"
            )
                i(data-lucide="arrow-left", class="w-4 h-4")
                | Quay lại danh sách

        //- Flash
        if success
            div(class="mb-6 p-4 rounded-xl bg-green-50 border border-green-200 text-green-800 text-sm")
                = success
        if error
            div(class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm")
                = error

        .bg-white.border.border-gray-200.rounded-2xl.p-6.shadow-sm
            h1(class="text-2xl font-bold text-gray-900 mb-6")
                if prompt
                    | Sửa Prompt
                else
                    | Thêm Prompt

            form(
                action=(prompt ? `/admin/prompts/${prompt._id}/edit` : '/admin/prompts')
                method="POST"
                class="space-y-5"
            )
                //- Tên
                div
                    label(class="block text-sm font-medium text-gray-700 mb-2")
                        | Tên prompt *
                    input(
                        type="text"
                        name="name"
                        required
                        value=(prompt && prompt.name) || ''
                        class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500"
                        placeholder="Ví dụ: Chấm chặt - Lập trình căn bản"
                    )

                //- Mô tả
                div
                    label(class="block text-sm font-medium text-gray-700 mb-2")
                        | Mô tả
                    textarea(
                        name="description"
                        rows="2"
                        class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500 resize-none"
                    )= (prompt && prompt.description) || ''

                //- Grid: strictness + maxScore + scope
                div(class="grid grid-cols-1 sm:grid-cols-3 gap-4")
                    div
                        label(class="block text-sm font-medium text-gray-700 mb-2")
                            | Mức độ chặt
                        select(
                            name="strictness"
                            class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500"
                        )
                            option(value="lenient", selected=(prompt && prompt.strictness === 'lenient')) Nhẹ nhàng
                            option(value="normal", selected=(!prompt || prompt.strictness === 'normal')) Bình thường
                            option(value="strict", selected=(prompt && prompt.strictness === 'strict')) Chặt
                            option(value="very_strict", selected=(prompt && prompt.strictness === 'very_strict')) Rất chặt

                    div
                        label(class="block text-sm font-medium text-gray-700 mb-2")
                            | Điểm tối đa
                        input(
                            type="number"
                            name="maxScore"
                            min="1"
                            max="100"
                            value=(prompt && prompt.maxScore) || 10
                            class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500"
                        )

                    div
                        label(class="block text-sm font-medium text-gray-700 mb-2")
                            | Phạm vi
                        select(
                            name="scope"
                            class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500"
                        )
                            option(value="global", selected=(!prompt || prompt.scope === 'global')) Toàn hệ thống
                            option(value="subject", selected=(prompt && prompt.scope === 'subject')) Theo môn
                            option(value="lesson", selected=(prompt && prompt.scope === 'lesson')) Theo bài

                //- Subject (nếu scope=subject)
                div
                    label(class="block text-sm font-medium text-gray-700 mb-2")
                        | Gán cho môn (nếu scope = "Theo môn")
                    select(
                        name="subjectId"
                        class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500"
                    )
                        option(value="") — Không chọn —
                        each s in subjects
                            option(
                                value=s._id
                                selected=(prompt && String(prompt.subjectId) === String(s._id))
                            )
                                = s.name

                //- Lessons (nếu scope=lesson) — 1 prompt có thể gán cho NHIỀU bài
                div
                    label(class="block text-sm font-medium text-gray-700 mb-2")
                        | Gán cho các bài (nếu scope = "Theo bài") — có thể chọn nhiều

                    input(
                        type="text"
                        id="lessonSearch"
                        placeholder="Tìm bài học theo tên hoặc môn..."
                        class="w-full mb-2 px-3 py-2 border border-gray-300 rounded-lg text-sm outline-none focus:ring-2 focus:ring-indigo-500"
                    )

                    div(id="lessonCheckboxList", class="max-h-56 overflow-y-auto border border-gray-200 rounded-lg divide-y divide-gray-100")
                        if lessons && lessons.length
                            each l in lessons
                                label(
                                    class="lesson-option flex items-center gap-2 px-3 py-2 text-sm hover:bg-gray-50 cursor-pointer"
                                    data-label=`${l.title} ${l.subjectId ? l.subjectId.name : ''}`.toLowerCase()
                                )
                                    input(
                                        type="checkbox"
                                        name="lessonIds"
                                        value=l._id
                                        checked=(prompt && prompt.lessonIds && prompt.lessonIds.some((id) => String(id) === String(l._id)))
                                        class="w-4 h-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 flex-shrink-0"
                                    )
                                    span
                                        = l.title
                                        if l.subjectId
                                            span(class="text-gray-400")
                                                |  — #{l.subjectId.name}
                        else
                            p(class="px-3 py-4 text-sm text-gray-400") Chưa có bài học nào.

                    p(class="text-xs text-gray-400 mt-1")
                        | Mỗi bài chỉ dùng 1 prompt tại 1 thời điểm — chọn bài ở đây sẽ tự gán prompt này cho bài đó (gỡ prompt cũ nếu có); bỏ chọn sẽ gỡ prompt này khỏi bài đó.

                    script.
                        (function () {
                            var input = document.getElementById('lessonSearch');
                            if (!input) return;
                            input.addEventListener('input', function (e) {
                                var q = e.target.value.trim().toLowerCase();
                                document.querySelectorAll('#lessonCheckboxList .lesson-option').forEach(function (el) {
                                    var label = el.getAttribute('data-label') || '';
                                    el.style.display = label.indexOf(q) !== -1 ? '' : 'none';
                                });
                            });
                        })();

                //- Rubric
                div
                    label(class="block text-sm font-medium text-gray-700 mb-2")
                        | Rubric (tổng weight = 100%)
                    p(class="text-xs text-gray-500 mb-2")
                        | Nhập JSON: [{"criterion": "Tên tiêu chí", "weight": 50, "description": "Mô tả"}]

                    textarea(
                        name="rubricJson"
                        rows="6"
                        class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500 font-mono text-sm resize-y"
                        placeholder='[{"criterion":"Đúng logic","weight":50,"description":"Thuật toán đúng"},{"criterion":"Trình bày","weight":50,"description":"Rõ ràng"}]'
                    )= prompt ? JSON.stringify(prompt.rubric || [], null, 2) : '[{"criterion": "Đúng logic", "weight": 50, "description": ""}, {"criterion": "Trình bày", "weight": 50, "description": ""}]'

                //- Content
                div
                    label(class="block text-sm font-medium text-gray-700 mb-2")
                        | Nội dung prompt *
                    p(class="text-xs text-gray-500 mb-2")
                        | Biến hỗ trợ: <code>{đề_bài}</code>, <code>{bài_làm}</code>, <code>{rubric}</code>, <code>{max_score}</code>, <code>{strictness}</code>, <code>{student_name}</code>, <code>{lời_giải_mẫu}</code>

                    textarea(
                        name="content"
                        rows="16"
                        required
                        class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500 font-mono text-sm resize-y"
                    )= (prompt && prompt.content) || `Bạn là giảng viên chấm bài.\nHãy chấm theo rubric sau:\n{rubric}\n\nĐề bài:\n{đề_bài}\n\nBài làm sinh viên:\n{bài_làm}\n\nYêu cầu trả về DUY NHẤT một object JSON:\n{\n  "score": number,\n  "feedback": string,\n  "breakdown": [{"criterion": string, "score": number, "comment": string}]\n}\n\nĐiểm tối đa: {max_score}`

                //- Checkboxes
                div(class="grid grid-cols-1 sm:grid-cols-2 gap-4")
                    div(class="flex items-center gap-2")
                        input(
                            type="checkbox"
                            id="isDefault"
                            name="isDefault"
                            checked=(prompt && prompt.isDefault)
                            class="w-4 h-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500"
                        )
                        label(for="isDefault", class="text-sm text-gray-700")
                            | ⭐ Đặt làm prompt mặc định (chỉ 1)

                    div(class="flex items-center gap-2")
                        input(
                            type="checkbox"
                            id="active"
                            name="active"
                            checked=(!prompt || prompt.active)
                            class="w-4 h-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500"
                        )
                        label(for="active", class="text-sm text-gray-700")
                            | Đang hoạt động

                //- Audit
                if prompt
                    div(class="pt-4 border-t border-gray-100 text-xs text-gray-500 space-y-1")
                        if prompt.createdBy
                            div
                                | Người tạo: #{prompt.createdBy.name || prompt.createdBy.email}
                        if prompt.createdAt
                            div
                                | Tạo lúc: #{new Date(prompt.createdAt).toLocaleString('vi-VN')}
                        if prompt.updatedAt
                            div
                                | Cập nhật: #{new Date(prompt.updatedAt).toLocaleString('vi-VN')}
                        div
                            | Version: v#{prompt.version || 1}

                //- Actions
                .flex.justify-end.gap-3.pt-4
                    a(
                        href="/admin/prompts"
                        class="px-4 py-2.5 rounded-lg border border-gray-300 text-gray-700 text-sm font-medium hover:bg-gray-50"
                    )
                        | Hủy

                    button(
                        type="submit"
                        class="px-4 py-2.5 rounded-lg bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-700"
                    )
                        if prompt
                            | Lưu thay đổi
                        else
                            | Tạo Prompt