extends ../layout

block content
    div(class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8")

        //- HEADER
        div(class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8")
            div
                h1(class="text-2xl sm:text-3xl font-bold text-gray-900")
                    | Quản lý Prompt chấm điểm
                p(class="text-gray-500 mt-1")
                    | Cấu hình prompt AI dùng để chấm bài

            a(
                href="/admin/prompts/create"
                class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700 transition"
            )
                i(data-lucide="plus", class="w-4 h-4")
                | Thêm Prompt

        //- FLASH
        if success
            div(class="mb-6 p-4 rounded-xl bg-green-50 border border-green-200 text-green-800 text-sm")
                = success
        if error
            div(class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm")
                = error

        //- FILTER
        div(class="bg-white border border-gray-200 rounded-xl p-4 mb-6")
            form(action="/admin/prompts", method="GET", class="flex flex-col sm:flex-row gap-3")
                select(
                    name="scope"
                    class="px-3 py-2.5 border border-gray-300 rounded-lg text-sm outline-none focus:ring-2 focus:ring-indigo-500"
                )
                    option(value="") Tất cả scope
                    option(value="global", selected=(filters && filters.scope === 'global')) Global
                    option(value="subject", selected=(filters && filters.scope === 'subject')) Theo môn
                    option(value="lesson", selected=(filters && filters.scope === 'lesson')) Theo bài

                select(
                    name="active"
                    class="px-3 py-2.5 border border-gray-300 rounded-lg text-sm outline-none focus:ring-2 focus:ring-indigo-500"
                )
                    option(value="") Tất cả trạng thái
                    option(value="1", selected=(filters && filters.active === '1')) Đang hoạt động
                    option(value="0", selected=(filters && filters.active === '0')) Đã tắt

                input(
                    type="text"
                    name="search"
                    value=(filters && filters.search) || ''
                    placeholder="Tìm theo tên prompt..."
                    class="flex-1 px-3 py-2.5 border border-gray-300 rounded-lg text-sm outline-none focus:ring-2 focus:ring-indigo-500"
                )

                button(
                    type="submit"
                    class="px-4 py-2.5 bg-gray-900 text-white rounded-lg text-sm font-medium hover:bg-gray-800"
                )
                    | Lọc

        //- LIST
        if prompts && prompts.length
            div(class="grid grid-cols-1 md:grid-cols-2 gap-5")
                each prompt in prompts
                    .bg-white.border.border-gray-200.rounded-2xl.p-5.shadow-sm

                        //- HEADER CARD
                        div(class="flex items-start justify-between gap-3 mb-3")
                            div(class="flex-1 min-w-0")
                                div(class="flex items-center gap-2 flex-wrap")
                                    h3(class="font-bold text-gray-900 truncate")
                                        = prompt.name
                                    if prompt.isDefault
                                        span(class="px-2 py-0.5 rounded-full text-xs font-semibold bg-yellow-100 text-yellow-800")
                                            | ⭐ Mặc định
                                    if !prompt.active
                                        span(class="px-2 py-0.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-600")
                                            | Đã tắt

                                div(class="flex items-center gap-2 mt-2 flex-wrap text-xs")
                                    span(class="px-2 py-0.5 rounded-full bg-blue-100 text-blue-700 font-medium")
                                        = prompt.scope || 'global'
                                    span(class="px-2 py-0.5 rounded-full bg-purple-100 text-purple-700 font-medium")
                                        = prompt.strictness || 'normal'
                                    span(class="px-2 py-0.5 rounded-full bg-green-100 text-green-700 font-medium")
                                        | Max: #{prompt.maxScore || 10}
                                    span(class="text-gray-400")
                                        | v#{prompt.version || 1}

                        if prompt.description
                            p(class="text-sm text-gray-600 mb-3 line-clamp-2")
                                = prompt.description

                        //- RUBRIC PREVIEW
                        if prompt.rubric && prompt.rubric.length
                            div(class="mb-3 p-3 rounded-lg bg-gray-50 border border-gray-100")
                                div(class="text-xs font-semibold text-gray-500 mb-2")
                                    | Rubric (#{prompt.rubric.length} tiêu chí)
                                each r in prompt.rubric
                                    div(class="flex items-center justify-between text-xs mb-1")
                                        span(class="text-gray-700 truncate")
                                            = r.criterion
                                        span(class="font-semibold text-gray-900")
                                            = r.weight + '%'

                        //- SCOPE INFO
                        if prompt.scope === 'subject' && prompt.subjectId
                            p(class="text-xs text-gray-500 mb-2")
                                | 📚 Môn: #{prompt.subjectId.name || '(đã xoá)'}
                        if prompt.scope === 'lesson' && prompt.lessonIds && prompt.lessonIds.length
                            p(class="text-xs text-gray-500 mb-2")
                                | 📝 Bài (#{prompt.lessonIds.length}): #{prompt.lessonIds.map((l) => l.title || '(đã xoá)').join(', ')}

                        //- AUDIT
                        div(class="text-xs text-gray-400 mb-3")
                            if prompt.createdAt
                                | Tạo: #{new Date(prompt.createdAt).toLocaleString('vi-VN')}

                        //- ACTIONS
                        div(class="flex items-center gap-2 pt-3 border-t border-gray-100")
                            a(
                                href=`/admin/prompts/${prompt._id}/edit`
                                class="inline-flex items-center gap-1 px-3 py-1.5 bg-gray-100 text-gray-700 rounded-lg text-xs font-medium hover:bg-gray-200"
                            )
                                i(data-lucide="pencil", class="w-3.5 h-3.5")
                                | Sửa

                            if !prompt.isDefault
                                form(
                                    action=`/admin/prompts/${prompt._id}/set-default`
                                    method="POST"
                                    class="inline"
                                )
                                    button(
                                        type="submit"
                                        class="inline-flex items-center gap-1 px-3 py-1.5 bg-yellow-50 text-yellow-700 rounded-lg text-xs font-medium hover:bg-yellow-100"
                                    )
                                        | ⭐ Đặt default

                            if prompt.active
                                form(
                                    action=`/admin/prompts/${prompt._id}/delete`
                                    method="POST"
                                    class="inline"
                                    onsubmit="return confirm('Vô hiệu hoá prompt này?')"
                                )
                                    button(
                                        type="submit"
                                        class="inline-flex items-center gap-1 px-3 py-1.5 bg-red-50 text-red-600 rounded-lg text-xs font-medium hover:bg-red-100"
                                    )
                                        i(data-lucide="power", class="w-3.5 h-3.5")
                                        | Tắt
                            else
                                form(
                                    action=`/admin/prompts/${prompt._id}/hard-delete`
                                    method="POST"
                                    class="inline"
                                    onsubmit="return confirm('XOÁ VĨNH VIỄN không thể hoàn tác. Chắc chắn?')"
                                )
                                    button(
                                        type="submit"
                                        class="inline-flex items-center gap-1 px-3 py-1.5 bg-red-50 text-red-700 rounded-lg text-xs font-medium hover:bg-red-100"
                                    )
                                        i(data-lucide="trash-2", class="w-3.5 h-3.5")
                                        | Xoá vĩnh viễn

        else
            .bg-white.border.border-gray-200.rounded-2xl.py-16.text-center
                .w-14.h-14.rounded-full.bg-gray-100.text-gray-400.flex.items-center.justify-center.mx-auto
                    i(data-lucide="bot", class="w-6 h-6")
                h2(class="font-semibold text-gray-900 mt-4")
                    | Chưa có prompt nào
                p(class="text-sm text-gray-500 mt-1")
                    | Tạo prompt đầu tiên để cấu hình AI chấm bài.
                a(
                    href="/admin/prompts/create"
                    class="inline-flex items-center gap-2 mt-5 px-4 py-2.5 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700"
                )
                    i(data-lucide="plus", class="w-4 h-4")
                    | Thêm Prompt