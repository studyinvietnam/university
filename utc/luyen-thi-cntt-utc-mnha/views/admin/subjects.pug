extends ../layout

block content
    .max-w-7xl.mx-auto.px-4.sm\\:px-6.lg\\:px-8.py-8

        .flex.flex-col.sm\\:flex-row.sm\\:items-center.sm\\:justify-between.gap-4.mb-8
            div
                h1(class="text-2xl sm:text-3xl font-bold text-gray-900")
                    | Quản lý môn học
                p(class="text-gray-500 mt-1")
                    | Quản lý danh sách môn học trong hệ thống

            button(
                type="button"
                onclick="openSubjectModal()"
                class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700 transition"
            )
                i(data-lucide="plus" class="w-4 h-4")
                | Thêm môn học

        if subjects && subjects.length
            .grid.grid-cols-1.md\\:grid-cols-2.lg\\:grid-cols-3.gap-5
                each subject in subjects
                    .bg-white.border.border-gray-200.rounded-2xl.p-5.shadow-sm
                        .flex.items-start.justify-between.gap-4
                            .flex.items-center.gap-3
                                .w-11.h-11.rounded-xl.bg-indigo-100.text-indigo-600.flex.items-center.justify-center
                                    i(data-lucide="book-open" class="w-5 h-5")

                                div
                                    h2(class="font-bold text-gray-900")
                                        = subject.name
                                    if subject.code
                                        p(class="text-xs text-gray-500 mt-0.5")
                                            = subject.code

                            .flex.items-center.gap-1
                                a(
                                    href="/admin/subjects/" + subject._id + "/edit"
                                    class="w-8 h-8 rounded-lg flex items-center justify-center text-gray-500 hover:bg-gray-100 hover:text-indigo-600"
                                    title="Chỉnh sửa"
                                )
                                    i(data-lucide="pencil" class="w-4 h-4")

                                form(
                                    action="/admin/subjects/" + subject._id + "/delete"
                                    method="POST"
                                    onsubmit="return confirm('Bạn có chắc muốn xóa môn học này?')"
                                )
                                    button(
                                        type="submit"
                                        class="w-8 h-8 rounded-lg flex items-center justify-center text-gray-500 hover:bg-red-50 hover:text-red-600"
                                        title="Xóa"
                                    )
                                        i(data-lucide="trash-2" class="w-4 h-4")

                        if subject.description
                            p(class="text-sm text-gray-600 mt-4 leading-6")
                                = subject.description

                        .mt-5.pt-4.border-t.border-gray-100.flex.items-center.justify-between
                            span(class="text-sm text-gray-500")
                                | Bài học

                            span(class="font-semibold text-gray-900")
                                = subject.lessonCount ?? subject.lessons?.length ?? 0

        else
            .bg-white.border.border-gray-200.rounded-2xl.py-16.text-center
                .w-14.h-14.rounded-full.bg-gray-100.text-gray-400.flex.items-center.justify-center.mx-auto
                    i(data-lucide="book-open" class="w-6 h-6")
                h2(class="font-semibold text-gray-900 mt-4")
                    | Chưa có môn học
                p(class="text-sm text-gray-500 mt-1")
                    | Hãy thêm môn học đầu tiên.

        //- Modal
        #subjectModal(class="hidden fixed inset-0 z-[100] bg-black/50 p-4")
            .min-h-full.flex.items-center.justify-center
                .bg-white.rounded-2xl.shadow-xl.w-full.max-w-lg
                    .px-6.py-5.border-b.border-gray-200.flex.items-center.justify-between
                        h2(class="text-lg font-bold text-gray-900")
                            | Thêm môn học

                        button(
                            type="button"
                            onclick="closeSubjectModal()"
                            class="w-8 h-8 rounded-lg hover:bg-gray-100 flex items-center justify-center"
                        )
                            i(data-lucide="x" class="w-5 h-5")

                    form(
                        action="/admin/subjects"
                        method="POST"
                        class="p-6 space-y-5"
                    )
                        div
                            label(class="block text-sm font-medium text-gray-700 mb-2")
                                | Tên môn học
                            input(
                                type="text"
                                name="name"
                                required
                                class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                                placeholder="Ví dụ: Cấu trúc dữ liệu và giải thuật"
                            )

                        div
                            label(class="block text-sm font-medium text-gray-700 mb-2")
                                | Mã môn học
                            input(
                                type="text"
                                name="code"
                                class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                                placeholder="Ví dụ: IT1.105.3"
                            )

                        div
                            label(class="block text-sm font-medium text-gray-700 mb-2")
                                | Mô tả
                            textarea(
                                name="description"
                                rows="4"
                                class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 resize-none"
                                placeholder="Mô tả môn học..."
                            )

                        .flex.justify-end.gap-3
                            button(
                                type="button"
                                onclick="closeSubjectModal()"
                                class="px-4 py-2.5 rounded-lg border border-gray-300 text-gray-700 text-sm font-medium hover:bg-gray-50"
                            )
                                | Hủy

                            button(
                                type="submit"
                                class="px-4 py-2.5 rounded-lg bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-700"
                            )
                                | Lưu môn học

    script.
        function openSubjectModal() {
            document.getElementById('subjectModal').classList.remove('hidden');
        }

        function closeSubjectModal() {
            document.getElementById('subjectModal').classList.add('hidden');
        }