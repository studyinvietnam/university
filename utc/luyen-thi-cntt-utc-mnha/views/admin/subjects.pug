extends ../layout

block content
    div(class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8")

        //- Header
        div(class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8")
            div
                h1(class="text-2xl sm:text-3xl font-bold text-gray-900")
                    | Quản lý môn học
                p(class="text-gray-500 mt-1")
                    | Quản lý danh sách môn học trong hệ thống

            div(class="flex items-center gap-2")
                if !showDeleted
                    a(
                        href="/admin/subjects?deleted=1"
                        class="inline-flex items-center gap-2 px-4 py-2.5 border border-gray-300 text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-50 transition"
                    )
                        i(data-lucide="trash-2", class="w-4 h-4")
                        | Thùng rác
                else
                    a(
                        href="/admin/subjects"
                        class="inline-flex items-center gap-2 px-4 py-2.5 border border-gray-300 text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-50 transition"
                    )
                        i(data-lucide="arrow-left", class="w-4 h-4")
                        | Danh sách

                if !showDeleted
                    button(
                        type="button"
                        onclick="openSubjectModal()"
                        class="inline-flex items-center gap-2 px-4 py-2.5 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700 transition"
                    )
                        i(data-lucide="plus", class="w-4 h-4")
                        | Thêm môn học

        //- Flash
        if success
            div(class="mb-6 p-4 rounded-xl bg-green-50 border border-green-200 text-green-800 text-sm")
                = success

        if error
            div(class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm")
                = error

        //- List
        if subjects && subjects.length
            div(class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5")
                each subject in subjects
                    .bg-white.border.border-gray-200.rounded-2xl.p-5.shadow-sm
                        .flex.items-start.justify-between.gap-4
                            .flex.items-center.gap-3
                                .w-11.h-11.rounded-xl.bg-indigo-100.text-indigo-600.flex.items-center.justify-center
                                    i(data-lucide="book-open", class="w-5 h-5")

                                div
                                    h2(class="font-bold text-gray-900")
                                        = subject.name
                                    if subject.code
                                        p(class="text-xs text-gray-500 mt-0.5")
                                            = subject.code

                            if !showDeleted
                                div(class="flex items-center gap-1")
                                    a(
                                        href=`/admin/subjects/${subject._id}/edit`
                                        class="w-8 h-8 rounded-lg flex items-center justify-center text-gray-500 hover:bg-gray-100 hover:text-indigo-600"
                                        title="Chỉnh sửa"
                                    )
                                        i(data-lucide="pencil", class="w-4 h-4")

                                    form(
                                        action=`/admin/subjects/${subject._id}/delete`
                                        method="POST"
                                        onsubmit="return confirm('Bạn có chắc muốn xoá môn học này?')"
                                    )
                                        button(
                                            type="submit"
                                            class="w-8 h-8 rounded-lg flex items-center justify-center text-gray-500 hover:bg-red-50 hover:text-red-600"
                                            title="Xoá"
                                        )
                                            i(data-lucide="trash-2", class="w-4 h-4")

                        if subject.description
                            p(class="text-sm text-gray-600 mt-4 leading-6 line-clamp-3")
                                = subject.description

                        //- Audit info
                        div(class="mt-4 text-xs text-gray-400 space-y-1")
                            if subject.createdBy
                                div
                                    | Tạo bởi: #{subject.createdBy.name || subject.createdBy.email}
                            if subject.createdAt
                                div
                                    | Tạo lúc: #{new Date(subject.createdAt).toLocaleString('vi-VN')}
                            if subject.updatedBy
                                div
                                    | Cập nhật bởi: #{subject.updatedBy.name || subject.updatedBy.email}
                            if subject.updatedAt
                                div
                                    | Cập nhật: #{new Date(subject.updatedAt).toLocaleString('vi-VN')}

                        .mt-5.pt-4.border-t.border-gray-100.flex.items-center.justify-between
                            span(class="text-sm text-gray-500")
                                | Bài học

                            span(class="font-semibold text-gray-900")
                                = subject.lessonCount || 0

                        if showDeleted
                            div(class="mt-4 flex items-center gap-2")
                                form(
                                    action=`/admin/subjects/${subject._id}/restore`
                                    method="POST"
                                    class="flex-1"
                                )
                                    button(
                                        type="submit"
                                        class="w-full inline-flex items-center justify-center gap-1 px-3 py-2 bg-green-50 text-green-700 rounded-lg text-xs font-medium hover:bg-green-100 transition"
                                    )
                                        i(data-lucide="rotate-ccw", class="w-3.5 h-3.5")
                                        | Khôi phục

                                form(
                                    action=`/admin/subjects/${subject._id}/hard-delete`
                                    method="POST"
                                    class="flex-1"
                                    onsubmit="return confirm('XOÁ VĨNH VIỄN không thể hoàn tác. Chắc chắn?')"
                                )
                                    button(
                                        type="submit"
                                        class="w-full inline-flex items-center justify-center gap-1 px-3 py-2 bg-red-50 text-red-700 rounded-lg text-xs font-medium hover:bg-red-100 transition"
                                    )
                                        i(data-lucide="trash", class="w-3.5 h-3.5")
                                        | Xoá vĩnh viễn

        else
            .bg-white.border.border-gray-200.rounded-2xl.py-16.text-center
                .w-14.h-14.rounded-full.bg-gray-100.text-gray-400.flex.items-center.justify-center.mx-auto
                    i(data-lucide="book-open", class="w-6 h-6")

                h2(class="font-semibold text-gray-900 mt-4")
                    if showDeleted
                        | Thùng rác trống
                    else
                        | Chưa có môn học

                p(class="text-sm text-gray-500 mt-1")
                    if showDeleted
                        | Không có môn học nào đã xoá.
                    else
                        | Hãy thêm môn học đầu tiên.

                if !showDeleted
                    button(
                        type="button"
                        onclick="openSubjectModal()"
                        class="inline-flex items-center gap-2 mt-5 px-4 py-2.5 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700 transition"
                    )
                        i(data-lucide="plus", class="w-4 h-4")
                        | Thêm môn học

        //- Modal tạo mới
        if !showDeleted
            div#subjectModal(class="hidden fixed inset-0 z-50 bg-black/50 p-4")
                .min-h-full.flex.items-center.justify-center
                    .bg-white.rounded-2xl.shadow-xl.w-full.max-w-lg
                        .px-6.py-5.border-b.border-gray-200.flex.items-center.justify-between
                            h2(class="text-lg font-bold text-gray-900")
                                | Thêm môn học

                            button(
                                type="button"
                                onclick="closeSubjectModal()"
                                class="w-8 h-8 rounded-lg hover:bg-gray-100 flex items-center justify-center"
                            )
                                i(data-lucide="x", class="w-5 h-5")

                        form(
                            action="/admin/subjects"
                            method="POST"
                            class="p-6 space-y-5"
                        )
                            div
                                label(class="block text-sm font-medium text-gray-700 mb-2")
                                    | Tên môn học *
                                input(
                                    type="text"
                                    name="name"
                                    required
                                    class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                                    placeholder="Ví dụ: Cấu trúc dữ liệu và giải thuật"
                                )

                            div
                                label(class="block text-sm font-medium text-gray-700 mb-2")
                                    | Mã môn học
                                input(
                                    type="text"
                                    name="code"
                                    class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                                    placeholder="Ví dụ: IT1.105.3"
                                )

                            div
                                label(class="block text-sm font-medium text-gray-700 mb-2")
                                    | Mô tả
                                textarea(
                                    name="description"
                                    rows="4"
                                    class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 resize-none"
                                    placeholder="Mô tả môn học..."
                                )

                            div(class="grid grid-cols-2 gap-4")
                                div
                                    label(class="block text-sm font-medium text-gray-700 mb-2")
                                        | Thứ tự
                                    input(
                                        type="number"
                                        name="order"
                                        value="0"
                                        class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                                    )

                                div(class="flex items-end")
                                    label(class="flex items-center gap-2 cursor-pointer")
                                        input(
                                            type="checkbox"
                                            name="isPublished"
                                            checked
                                            class="w-4 h-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500"
                                        )
                                        span(class="text-sm text-gray-700")
                                            | Công khai

                            .flex.justify-end.gap-3.pt-2
                                button(
                                    type="button"
                                    onclick="closeSubjectModal()"
                                    class="px-4 py-2.5 rounded-lg border border-gray-300 text-gray-700 text-sm font-medium hover:bg-gray-50"
                                )
                                    | Hủy

                                button(
                                    type="submit"
                                    class="px-4 py-2.5 rounded-lg bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-700"
                                )
                                    | Lưu môn học

    script.
        function openSubjectModal() {
            document.getElementById('subjectModal').classList.remove('hidden');
        }
        function closeSubjectModal() {
            document.getElementById('subjectModal').classList.add('hidden');
        }