extends ../layout

block content
    div(class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8")

        div(class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6")
            div
                h1(class="text-2xl sm:text-3xl font-bold text-gray-900") Quản lý User Key
                p(class="text-gray-500 mt-1") Mỗi User Key là một tổ chức có nội dung (môn học, bài luyện tập) riêng. Chỉ admin default tạo được.
            a(href="/admin/dashboard" class="text-sm text-indigo-600 hover:underline") ← Dashboard

        if error
            div(class="mb-4 p-3 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700")= error
        if success
            div(class="mb-4 p-3 rounded-lg bg-green-50 border border-green-200 text-sm text-green-700")= success

        //- Tạo mới
        form(method="POST" action="/admin/user-keys" class="bg-white border border-gray-200 rounded-2xl p-5 shadow-sm mb-6")
            h2(class="font-semibold text-gray-900 mb-3") Tạo tổ chức mới
            div(class="grid grid-cols-1 sm:grid-cols-3 gap-3")
                input(type="text" name="name" required maxlength="200" placeholder="Tên tổ chức" class="px-3 py-2 border border-gray-300 rounded-lg text-sm sm:col-span-1")
                input(type="text" name="code" maxlength="32" placeholder="Mã (bỏ trống = tự sinh)" class="px-3 py-2 border border-gray-300 rounded-lg text-sm uppercase")
                button(type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700 transition") Tạo tổ chức

        //- Danh sách
        div(class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden")
            if !userKeys.length
                p(class="p-8 text-center text-gray-400 text-sm") Chưa có tổ chức nào.
            else
                div(class="overflow-x-auto")
                    table(class="w-full text-sm")
                        thead(class="bg-gray-50")
                            tr
                                th(class="px-5 py-3 text-left font-semibold text-gray-600") Tổ chức
                                th(class="px-5 py-3 text-left font-semibold text-gray-600") Mã
                                th(class="px-5 py-3 text-left font-semibold text-gray-600") Admin
                                th(class="px-5 py-3 text-left font-semibold text-gray-600") Student
                                th(class="px-5 py-3 text-left font-semibold text-gray-600") Chờ duyệt
                                th(class="px-5 py-3 text-left font-semibold text-gray-600") Kết nối thêm
                                th(class="px-5 py-3 text-left font-semibold text-gray-600") Trạng thái
                                th(class="px-5 py-3 text-right font-semibold text-gray-600") Hành động
                        tbody(class="divide-y divide-gray-100")
                            each k in userKeys
                                tr(class="hover:bg-gray-50")
                                    td(class="px-5 py-4")
                                        form(method="POST" action=`/admin/user-keys/${k._id}/update` class="flex items-center gap-2")
                                            input(type="text" name="name" value=k.name maxlength="200" class="px-2 py-1 border border-gray-200 rounded text-sm w-48")
                                            button(type="submit" class="text-xs text-indigo-600 hover:underline") Lưu
                                    td(class="px-5 py-4")
                                        span(class="font-mono text-xs px-2 py-1 rounded bg-indigo-50 text-indigo-700")= k.code
                                    td(class="px-5 py-4")= k.stats.admins
                                    td(class="px-5 py-4")= k.stats.students
                                    td(class="px-5 py-4")= k.stats.clients
                                    td(class="px-5 py-4")= k.stats.connected
                                    td(class="px-5 py-4")
                                        if k.active
                                            span(class="inline-flex px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 text-green-700") Đang bật
                                        else
                                            span(class="inline-flex px-2.5 py-1 rounded-full text-xs font-medium bg-gray-200 text-gray-600") Đã tắt
                                    td(class="px-5 py-4 text-right")
                                        form(method="POST" action=`/admin/user-keys/${k._id}/toggle` class="inline")
                                            button(type="submit" class="px-3 py-1.5 rounded-lg text-xs font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition")= k.active ? 'Tắt' : 'Bật'
