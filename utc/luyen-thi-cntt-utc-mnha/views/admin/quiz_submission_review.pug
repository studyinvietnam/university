//- views/admin/quiz_submission_review.pug
extends ../layout
include ../partials/quiz-result

block content
  .max-w-5xl.mx-auto.px-4.py-6
    h1.text-2xl.font-bold.mb-2 Nhận xét bài trắc nghiệm
    .text-sm.text-gray-500.mb-4
      | Sinh viên: #{student ? student.name + ' (' + student.email + ')' : '—'}
      |  · Bài: #{lesson.title}

    +renderQuizResult(doc, formatAiLabel)

    .bg-white.border.rounded-lg.p-4.shadow
      h3.text-lg.font-semibold.mb-2 Nhận xét của giảng viên
      if doc.teacherComment
        .mb-2.text-sm.text-gray-600
          | Đã có nhận xét của #{doc.teacherComment.commentedByName || 'Giảng viên'} lúc #{new Date(doc.teacherComment.commentedAt).toLocaleString('vi-VN')}
      else
        .mb-2.text-sm.text-gray-500 Chưa có nhận xét của giảng viên (không bắt buộc)

      textarea#commentInput(rows="5" required).w-full.border.rounded.p-2= doc.teacherComment ? doc.teacherComment.content : ''
      .mt-2
        button#saveCommentBtn.px-4.py-2.bg-blue-600.text-white.rounded= doc.teacherComment ? 'Cập nhật nhận xét' : 'Lưu nhận xét'

  script.
    window.__QUIZ_SUBMISSION_ID__ = '#{submission._id}';

  script.
    document.getElementById('saveCommentBtn').addEventListener('click', async () => {
      const content = document.getElementById('commentInput').value.trim();
      if (!content) { alert('Vui lòng nhập nội dung nhận xét'); return; }
      const btn = document.getElementById('saveCommentBtn');
      btn.disabled = true; btn.textContent = 'Đang lưu…';
      try {
        const r = await fetch(`/admin/quiz-submissions/${window.__QUIZ_SUBMISSION_ID__}/review`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content }),
        });
        const j = await r.json();
        if (!r.ok) throw new Error(j.msg || 'Lỗi lưu');
        location.reload();
      } catch (e) {
        alert(e.message);
        btn.disabled = false; btn.textContent = 'Lưu nhận xét';
      }
    });