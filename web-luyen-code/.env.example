# ============================================================
# NỀN TẢNG LUYỆN CODE - ENVIRONMENT VARIABLES (MẪU)
# ============================================================

# Server
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI="mongodb+srv://hunganhokokok0_db_user:xxxxxxxxxxxxxxxx@cluster0.tqstoad.mongodb.net/?appName=Cluster0"
JWT_SECRET="your_jwt_secret_key_change_in_production"

# Email 1 - Primary
SMTP_PRIMARY_HOST=smtp.gmail.com
SMTP_PRIMARY_PORT=587
SMTP_PRIMARY_USER="your_email_1@gmail.com"
SMTP_PRIMARY_PASSWORD="your_app_password_1"

# Email 2 - Fallback
SMTP_FALLBACK_HOST=smtp.gmail.com
SMTP_FALLBACK_PORT=587
SMTP_FALLBACK_USER="your_email_2@gmail.com"
SMTP_FALLBACK_PASSWORD="your_app_password_2"

# GitHub
GITHUB_TOKEN="your_github_personal_access_token"
GITHUB_OWNER="hunganhcodeserver"
GITHUB_REPO="web-luyen-code-data"
GITHUB_BRANCH="main"

# AI Provider
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash

# AI API Keys
GEMINI_API_KEY="your_gemini_api_key"
OPENAI_API_KEY="your_openai_api_key"
DEEPSEEK_API_KEY="your_deepseek_api_key"
CLAUDE_API_KEY="your_claude_api_key"

# Docker Execution
DOCKER_CPU_LIMIT=0.5
DOCKER_MEMORY_LIMIT=256m
DOCKER_EXECUTION_TIMEOUT=5000
DOCKER_OUTPUT_SIZE_LIMIT=1048576